{
  "name": "StatSubmission",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Game ID"
    },
    "user_id": {
      "type": "string",
      "description": "Player user ID"
    },
    "user_name": {
      "type": "string",
      "description": "Player name"
    },
    "goals": {
      "type": "number",
      "default": 0
    },
    "assists": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "game_id",
    "user_id"
  ]
}