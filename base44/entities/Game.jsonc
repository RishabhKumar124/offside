{
  "name": "Game",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Game title"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Game date and time"
    },
    "location_name": {
      "type": "string",
      "description": "Venue or field name"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "max_players": {
      "type": "number",
      "description": "Maximum number of players allowed"
    },
    "rules": {
      "type": "string",
      "description": "General rules or notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "host_id": {
      "type": "string",
      "description": "User ID of the host"
    },
    "host_name": {
      "type": "string",
      "description": "Host display name"
    },
    "host_photo": {
      "type": "string",
      "description": "Host profile photo URL"
    },
    "dark_team": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      },
      "description": "Dark team players"
    },
    "white_team": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          }
        }
      },
      "description": "White team players"
    },
    "dark_score": {
      "type": "number",
      "description": "Dark team final score"
    },
    "white_score": {
      "type": "number",
      "description": "White team final score"
    },
    "mvp_user_id": {
      "type": "string",
      "description": "MVP player user ID"
    },
    "mvp_name": {
      "type": "string",
      "description": "MVP player name"
    },
    "stats_locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether stats are finalized"
    },
    "teams_announced": {
      "type": "boolean",
      "default": false,
      "description": "Whether teams have been announced"
    }
  },
  "required": [
    "title",
    "date",
    "location_name",
    "max_players",
    "host_id"
  ]
}