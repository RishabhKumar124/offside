{
  "name": "Comment",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Game ID"
    },
    "user_id": {
      "type": "string",
      "description": "Author user ID"
    },
    "user_name": {
      "type": "string",
      "description": "Author name"
    },
    "user_photo": {
      "type": "string",
      "description": "Author photo"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent comment ID for replies"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who liked"
    },
    "dislikes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who disliked"
    }
  },
  "required": [
    "game_id",
    "user_id",
    "content"
  ]
}